	(text "ATmega16U2 at 5 V, 16 MHz. DUT_VCC is measured by the power meter; DUT_5V (before the shunt) feeds pull-ups."
		(exclude_from_sim no)
		(at 15.24 12.7 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "72115d87-cc7c-5b10-997a-f6cab3c39d3b")
	)
	(text "Software USB (V-USB): D+ = PC7 (INT4), D- = PC4. 75R series and 3.6 V zeners keep the lines at USB levels."
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "af2627a6-6d50-5225-b5c3-50c4d07126d5")
	)
	(text "Reset: the Pi side holds RESET low by default (pi_io sheet). The diode keeps 12 V (HVPP) off DUT_5V."
		(exclude_from_sim no)
		(at 15.24 17.78 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "553be4f0-04d6-526e-b137-3a2b9c1fb0a8")
	)
	(text "Crystal (option XTAL) joins XTAL1 through an analog switch (option XSW): GPIO23 high disconnects it, so a"
		(exclude_from_sim no)
		(at 15.24 20.32 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "151ccb56-358d-53ec-9804-d4d0ca75d859")
	)
	(text "driven clock sees a bare XTAL1. Without XSW, the 0R bypass is fitted instead (crystal always connected)."
		(exclude_from_sim no)
		(at 15.24 22.86 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "9226067a-5a78-5160-a675-9657dc290d1e")
	)
	(text "Load: the switch's ~13 pF on-capacitance stands in for the XTAL1-side 12 pF cap, so that cap is fitted only"
		(exclude_from_sim no)
		(at 15.24 25.4 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "50558b58-8497-5344-9992-1b9e8ef7db50")
	)
	(text "without the switch. CL = 13*12/25 + ~3 pF stray = 9.2 pF (crystal wants 9 pF)."
		(exclude_from_sim no)
		(at 15.24 27.94 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "0ca91232-e129-59b3-a595-856fce081fcc")
	)

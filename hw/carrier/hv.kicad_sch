	(text "12 V boost (MT3608, GPIO26) and a switch that puts it on RESET (GPIO25). Both default off."
		(exclude_from_sim no)
		(at 15.24 12.7 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "15503eea-8918-504b-a063-47f68cb03fae")
	)
	(text "FB divider 100k/5.1k: 12.36 V nominal. The 1k series resistor drops about 0.25 V at the 250 uA RESET current,"
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "d333c983-b76b-5d96-a749-43d2b0814a52")
	)
	(text "so RESET sees 11.9-12.4 V (spec 11.5-12.5 V)."
		(exclude_from_sim no)
		(at 15.24 17.78 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "05d3fa70-d7c3-5278-a632-a0b026f55032")
	)
	(text "TCA6416A: VCCP on +5V (always up before +3V3, as TI recommends). ~RESET is pulled up to DUT_5V, so the"
		(exclude_from_sim no)
		(at 15.24 20.32 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "85886601-26bc-5aff-a989-fcca7082ff1d")
	)
	(text "expander's ports are held as inputs (Hi-Z) whenever the DUT is off. I2C address 0x20."
		(exclude_from_sim no)
		(at 15.24 22.86 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "de46c0c0-ccae-5978-bd34-566c8808d6be")
	)
	(text "HVPP map (16U2 table 25-9): P0 = PB0-7 data; P10 PD1 RDY/BSY, P11 PD2 OE, P12 PD3 WR, P13 PD4 BS1,"
		(exclude_from_sim no)
		(at 15.24 25.4 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "e69de4a0-6a60-5128-a019-8aaffd224798")
	)
	(text "P14 PD5 XA0, P15 PD6 XA1, P16 PD7 PAGEL, P17 PC6 BS2."
		(exclude_from_sim no)
		(at 15.24 27.94 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "0b88d746-1c40-5ce8-92b5-a45419a7fbf7")
	)

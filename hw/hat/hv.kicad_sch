	(text "12 V boost (MT3608, GPIO26) and a switch that puts it on RESET (GPIO25). Both default off."
		(exclude_from_sim no)
		(at 15.24 12.7 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "386b913b-4a15-581c-b9b6-ad542c479804")
	)
	(text "FB divider 100k/5.1k: 12.36 V nominal. The 1k series resistor drops about 0.25 V at the 250 uA RESET current,"
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "c4d82b1c-637a-50cc-a026-9e0011ab3634")
	)
	(text "so RESET sees 11.9-12.4 V (spec 11.5-12.5 V)."
		(exclude_from_sim no)
		(at 15.24 17.78 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "75f06d99-3c9a-55dc-ab02-0e2ebb7c700c")
	)
	(text "TCA6416A: VCCP on +5V (always up before +3V3, as TI recommends). ~RESET is pulled up to DUT_5V, so the"
		(exclude_from_sim no)
		(at 15.24 20.32 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "d78e9791-410d-587d-9263-3afff9b9e8a6")
	)
	(text "expander's ports are held as inputs (Hi-Z) whenever the DUT is off. I2C address 0x20."
		(exclude_from_sim no)
		(at 15.24 22.86 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "ca900cf6-23de-5b0d-a818-8ed3abd77ebf")
	)
	(text "HVPP map (16U2 table 25-9): P0 = PB0-7 data; P10 PD1 RDY/BSY, P11 PD2 OE, P12 PD3 WR, P13 PD4 BS1,"
		(exclude_from_sim no)
		(at 15.24 25.4 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "c79f9d98-9d2f-540e-9d09-7b486ba0eeac")
	)
	(text "P14 PD5 XA0, P15 PD6 XA1, P16 PD7 PAGEL, P17 PC6 BS2."
		(exclude_from_sim no)
		(at 15.24 27.94 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "c94c9f41-1867-543d-8d94-0240ac138b64")
	)
